# PART 5: SETUP AND RUN SCRIPTS

## 5.1 ROCm Setup Script
```bash
#!/bin/bash
# scripts/setup_rocm.sh

echo "═══════════════════════════════════════════"
echo "  SovereignAI-AMD: ROCm Environment Setup"
echo "═══════════════════════════════════════════"

echo "[1/6] Checking AMD GPU..."
rocm-smi --showid

echo "[2/6] Checking ROCm version..."
rocminfo | grep "ROCm" | head -3

echo "[3/6] Installing Python dependencies..."
pip install -r requirements.txt

echo "[4/6] Installing vLLM for ROCm..."
pip install vllm --extra-index-url https://download.pytorch.org/whl/rocm6.0

echo "[5/6] Verifying GPU memory..."
rocm-smi --showmeminfo vram
```

## 5.2 Model Download Script
```bash
#!/bin/bash
# scripts/download_models.sh

huggingface-cli login --token $HF_TOKEN

python -c "
from huggingface_hub import snapshot_download
snapshot_download('Qwen/Qwen2.5-7B-Instruct', local_dir='./models/qwen2.5-7b')
snapshot_download('meta-llama/Llama-3.3-70B-Instruct', local_dir='./models/llama-3.3-70b')
snapshot_download('Qwen/Qwen2.5-14B-Instruct', local_dir='./models/qwen2.5-14b')
"
```

